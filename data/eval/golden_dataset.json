{
  "_meta": {
    "name": "Zero-Guessing Document AI - Golden Evaluation Benchmark",
    "version": "1.0",
    "description": "24 hand-labelled cases. Gold labels were written from the PDFs themselves (page numbers are 1-based, as stored in chunk.page) and never from model output.",
    "field_notes": {
      "expected_doc_ids": "doc_ids (slug of the PDF file stem) that hold the evidence. Empty for abstention cases (no evidence exists).",
      "expected_pages": "Map doc_id -> list of 1-based pages holding the evidence. A retrieved chunk is relevant iff (doc_id, page) is one of these pairs.",
      "expected_status": "answered | partially_answered | contradicted | abstained | clarification_needed (the last = the system must ask for the missing calculation inputs instead of guessing).",
      "expected_active_doc": "doc_id of the version that is in force after resolving the amendment chain; null when the question is not about a versioned rule.",
      "expect_contradiction": "True iff an UNRESOLVED conflict between documents must be raised. Conflicts explained by an amendment (v1->v2->v3, circular 61 amends 28) must NOT be raised.",
      "expect_abstention": "True iff the documents contain no proof and the system must refuse (no claim may be shown).",
      "expected_value": "Optional string or list of strings that must all appear (after normalising case, commas and currency symbols) in the verified claims / calculation result.",
      "forbidden_values": "Optional: strings that must NOT appear in any verified claim (disambiguation errors).",
      "expected_missing_keywords": "Optional: keywords that must be flagged in missing_evidence (partial proof).",
      "language": "en | hi"
    },
    "corpora": {
      "acme": {
        "description": "Acme Loan Policy v1 -> v2 -> v3 (supersedes chain, fee table, multi-page clauses) + an unrelated Operations Notice that contradicts v3.",
        "files": [
          "data/samples/Acme_Loan_Policy_v1.pdf",
          "data/samples/Acme_Loan_Policy_v2.pdf",
          "data/samples/Acme_Loan_Policy_v3.pdf",
          "data/samples/Acme_Operations_Notice.pdf"
        ]
      },
      "rbi": {
        "description": "Real RBI circulars: DoR.MCS.REC.28 (penal charges, 16 pp), DoR.MCS.REC.61 (extends the timeline of 28), DoR.MCS.REC.38 (release of property documents).",
        "files": [
          "data/uploads/FAIRLENDINGPRACTICE1B9DBE75410B4DA881E6EF953304B6F7.pdf",
          "data/uploads/PENALCHARGES26A3A63141764128942EDBA48A78A491.pdf",
          "data/uploads/NOTI60936A9DFA85554DD1BF77BCF4611AA69D.pdf"
        ]
      },
      "hackasol": {
        "description": "Hackasol 5.0 problem-statement booklet (10 pp): AIML-02 vs CS-01 disambiguation with table-of-contents distractors on pp. 2-3.",
        "files": [
          "data/uploads/Hackasol_5.0_Problem_Statement.pdf"
        ]
      }
    },
    "doc_aliases": {
      "fairlendingpractice1b9dbe75410b4da881e6ef953304b6f7": "RBI circular DoR.MCS.REC.28/01.01.001/2023-24 (18 Aug 2023)",
      "penalcharges26a3a63141764128942edba48a78a491": "RBI circular DoR.MCS.REC.61/01.01.001/2023-24 (29 Dec 2023) - amends 28",
      "noti60936a9dfa85554dd1bf77bcf4611aa69d": "RBI circular DoR.MCS.REC.38/01.01.001/2023-24 (13 Sep 2023)"
    }
  },
