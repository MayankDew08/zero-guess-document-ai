# LLM (Ollama - local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120

# Embeddings (local) - bge-m3 for EN+HI
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=sentence-transformers  # sentence-transformers | ollama
EMBEDDING_DEVICE=cpu

# Reranker (local HF, lazy singleton, fp16)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=12
RERANKER_KEEP_TOP_N=5
RERANK_ABSTAIN_THRESHOLD=0.25

# NLI verifier / contradiction detector (local HF, lazy singleton, fp16)
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
NLI_ENTAILMENT_THRESHOLD=0.65
NLI_CONTRADICTION_THRESHOLD=0.70
USE_FP16=true

# Retrieval
CHUNK_TARGET_CHARS=450
CHUNK_OVERLAP_CHARS=80
HYBRID_TOP_K=12

# Storage
DATA_DIR=../data
INDEX_DIR=../data/index
SAMPLE_DIR=../data/samples
REPORT_DIR=../data/reports

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
