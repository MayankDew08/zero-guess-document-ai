# LLM (Ollama - local, GPU)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=15m
LLM_TIMEOUT_SECONDS=120
# GPU layers for Ollama (0 = let Ollama auto-fit). Tune per card: on a 4 GB RTX 3050 Ti, 24 is ~2x faster
# than auto-fit for the 7B, while 28+ spills into shared memory and gets slower. Needs a CUDA-enabled
# Ollama build (the Arch 'ollama' package is CPU-only); 3B fully offloads and needs no override.
LLM_NUM_GPU=24

# Embeddings (local HF on CPU so VRAM stays free for Ollama) - bge-m3 for EN+HI
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Reranker (local HF cross-encoder, lazy singleton, CPU)
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_TOP_K=20
RERANKER_KEEP_TOP_N=7
RERANK_ABSTAIN_THRESHOLD=0.25

# NLI verifier / contradiction detector (local HF, lazy singleton, CPU)
NLI_PROVIDER=hf
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
NLI_DEVICE=cpu
NLI_ENTAILMENT_THRESHOLD=0.65
NLI_CONTRADICTION_THRESHOLD=0.70
USE_FP16=true

# Retrieval
CHUNK_TARGET_CHARS=450
CHUNK_OVERLAP_CHARS=0
HYBRID_TOP_K=20

# Storage
DATA_DIR=../data
INDEX_DIR=../data/index
SAMPLE_DIR=../data/samples
REPORT_DIR=../data/reports

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Local-first: models are cached, so never call the HuggingFace Hub at runtime (set to 0 only for the first download)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
